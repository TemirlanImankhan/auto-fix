{
  "name": "autofix-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Windows desktop installer for AutoFix",
  "author": "TemirlanImankhan",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.autofix.desktop",
    "productName": "AutoFix",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "setup.html"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "AutoFix-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
